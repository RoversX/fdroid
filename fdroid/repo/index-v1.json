{"repo": {"timestamp": 1795263492000, "version": 20002, "name": "CloseX", "icon": "icon.png", "address": "https://raw.githubusercontent.com/RoversX/fdroid/dist/fdroid/repo", "description": "Apps from CloseX: ThinkTerm for Android, updated with every ThinkTerm release."}, "requests": {"install": [], "uninstall": []}, "apps": [{"categories": ["System"], "changelog": "https://github.com/RoversX/ThinkTerm/releases", "suggestedVersionCode": "50300", "description": "ThinkTerm for Android opens the terminals you run in ThinkTerm on your\ncomputers and servers. The programs keep running there; the phone picks\nup the same threads and panes you left on the desktop.\n\n* Every thread on every host on one home screen, each with a live preview\n* Switch panes, see how they are split, zoom one to the whole screen\n* A key bar with Esc, Tab, Ctrl, arrows and more, over any keyboard\n* Send photos, files and clipboard images into a session\n* Connect over SSH, or through Tailscale built into the app\n* Follows the system's light or dark mode, in your terminal's colors\n\nKeep the app and ThinkTerm on your hosts on the same release: each\nrelease of the app talks to the ThinkTerm of the same version.", "issueTracker": "https://github.com/RoversX/ThinkTerm/issues", "license": "GPL-3.0-only", "name": "ThinkTerm", "sourceCode": "https://github.com/RoversX/ThinkTerm", "summary": "Pick up your ThinkTerm terminals from your phone", "webSite": "https://closex.org/thinkterm", "added": 1794816100000, "packageName": "com.roversx.thinkterm", "lastUpdated": 1795263492000, "localized": {"en-US": {"icon": "icon_PFTW2bUzgVuer0hYM9vrJzKwrMVtJERBOvNrI8zY-1s=.png"}}}], "packages": {"com.roversx.thinkterm": [{"added": 1795263492000, "apkName": "ThinkTerm-android-arm64-0.5.3.apk", "hash": "0cdaf7d62476f0e62a5ca77bde90ceb29f04fa2a04d88aace8215cd8bed2a54a", "hashType": "sha256", "minSdkVersion": 33, "nativecode": ["arm64-v8a"], "packageName": "com.roversx.thinkterm", "sig": "a55da3afbb904a5ef94cefe59d89