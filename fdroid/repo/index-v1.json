{"repo": {"timestamp": 1795766399000, "version": 20002, "name": "CloseX", "icon": "icon.png", "address": "https://raw.githubusercontent.com/RoversX/fdroid/dist/fdroid/repo", "description": "Apps from CloseX: ThinkTerm for Android, updated with every ThinkTerm release."}, "requests": {"install": [], "uninstall": []}, "apps": [{"categories": ["Development", "System"], "changelog": "https://github.com/RoversX/ThinkTerm/releases", "suggestedVersionCode": "60200", "description": "ThinkTerm for Android opens the terminals you run in ThinkTerm on your\ncomputers and servers. The programs keep running there; the phone picks\nup the same threads and panes you left on the desktop.\n\n* Every thread on every host on one home screen, each with a live preview\n* Switch panes, see how they are split, zoom one to the whole screen\n* A key bar with Esc, Tab, Ctrl, arrows and more, over any keyboard\n* Send photos, files and clipboard images into a session\n* Connect over SSH, or through Tailscale built into the app\n* Follows the system's light or dark mode, in your terminal's colors\n\nKeep the app and ThinkTerm on your hosts on the same release: each\nrelease of the app talks to the ThinkTerm of the same version.", "issueTracker": "https://github.com/RoversX/ThinkTerm/issues", "license": "GPL-3.0-only", "name": "ThinkTerm", "sourceCode": "https://github.com/RoversX/ThinkTerm", "summary": "Pick up your ThinkTerm terminals from your phone", "webSite": "https://closex.org/thinkterm", "added": 1795601261000, "packageName": "com.roversx.thinkterm", "lastUpdated": 1795744203000, "localized": {"en-US": {"featureGraphic": "featureGraphic_OrtcJMcdDsu8pIzxDehw6mlV6n0v7vRmC_gyCoY4NYI=.png", "icon": "icon_PFTW2bUzgVuer0hYM9vrJzKwrMVtJERBOvNrI8zY-1s=.png", "phoneScreenshots": ["1.png", "2.png", "3.png", "4.png", "5.png", "6.png"]}}}], "packages": {"com.roversx.thinkterm": [{"added": 1795744203000, "apkName": "ThinkTerm-android-arm64-0.6.2.apk", "hash": "ba8057d348f150b45b5b8fdb0153777468656b8