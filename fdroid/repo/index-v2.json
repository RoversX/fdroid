en-US/phoneScreenshots/6.png", "sha256": "c2e1c20b17b64ce7330291a811c15b1537fb5cfc7cf55b67f17cf372e1343ceb", "size": 2244896}]}}, "name": {"en-US": "ThinkTerm"}, "summary": {"en-US": "Pick up your ThinkTerm terminals from your phone"}, "description": {"en-US": "ThinkTerm for Android opens the terminals you run in ThinkTerm on your\ncomputers and servers. The programs keep running there; the phone picks\nup the same threads and panes you left on the desktop.\n\n* Every thread on every host on one home screen, each with a live preview\n* Switch panes, see how they are split, zoom one to the whole screen\n* A key bar with Esc, Tab, Ctrl, arrows and more, over any keyboard\n* Send photos, files and clipboard images into a session\n* Connect over SSH, or through Tailscale built into the app\n* Follows the system's light or dark mode, in your terminal's colors\n\nKeep the app and ThinkTerm on your hosts on the same release: each\nrelease of the app talks to the ThinkTerm of the same version."}, "icon": {"en-US": {"name": "/com.roversx.thinkterm/en-US/icon_PFTW2bUzgVuer0hYM9vrJzKwrMVtJERBOvNrI8zY-1s=.png", "sha256": "3c54d6d9b533815b9eaf485833dbeb2732b0acc56d2444413af36b23ccd8fb5b", "size": 95959}}, "preferredSigner": "4b4f9a600475356e4f8ab9c45645492ad4a482d2866059f8b9719e28833cb7f3"}, "versions": {"ba8057d348f150b45b5b8fdb0153777468656b84e362cd81f0c156696e4b8516": {"added": 1795744203000, "file": {"name": "/ThinkTerm-android-arm64-0.6.2.apk", "sha256": "ba8057d348f150b45b5b8fdb0153777468656b84e362cd81f0c156696e4b8516", "size": 42463130}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "0.6.2", "versionCode": 60200, "usesSdk": {"minSdkVersion": 33, "targetSdkVersion": 36}, "signer": {"sha256": ["4b4f9a600475356e4f8ab9c45645492ad4a482d2866059f8b9719e28833cb7f3"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.FOREGROUND_SERVICE"}, 